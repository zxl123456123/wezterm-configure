+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn music_config() -> Config {
+        Config {
+            keybind_prev: "F7".into(),
+            keybind_toggle_play_pause: "F8".into(),
+            keybind_next: "F9".into(),
+            keybind_fullscreen_prev: "Left".into(),
+            keybind_fullscreen_toggle_play_pause: "Space".into(),
+            keybind_fullscreen_next: "Right".into(),
+            ..Config::default()
+        }
+    }
+
+    #[test]
+    fn host_music_keys_work_in_fullscreen() {
+        let config = music_config();
+        for (code, action) in [
+            (KeyCode::F(7), Action::Prev),
+            (KeyCode::F(8), Action::TogglePlayPause),
+            (KeyCode::F(9), Action::Next),
+        ] {
+            assert_eq!(
+                map_key(KeyEvent::new(code, KeyModifiers::NONE), Overlay::None, &config),
+                action
+            );
+        }
+    }
+
+    #[test]
+    fn existing_fullscreen_keys_still_work() {
+        let config = music_config();
+        for (code, action) in [
+            (KeyCode::Left, Action::Prev),
+            (KeyCode::Char(' '), Action::TogglePlayPause),
+            (KeyCode::Right, Action::Next),
+        ] {
+            assert_eq!(
+                map_key(KeyEvent::new(code, KeyModifiers::NONE), Overlay::None, &config),
+                action
+            );
+        }
+    }
+
+    #[test]
+    fn configured_fullscreen_keys_still_work() {
+        let config = Config {
+            keybind_fullscreen_prev: "F1".into(),
+            keybind_fullscreen_toggle_play_pause: "F2".into(),
+            keybind_fullscreen_next: "F3".into(),
+            ..music_config()
+        };
+        for (code, action) in [
+            (KeyCode::F(1), Action::Prev),
+            (KeyCode::F(2), Action::TogglePlayPause),
+            (KeyCode::F(3), Action::Next),
+        ] {
+            assert_eq!(
+                map_key(KeyEvent::new(code, KeyModifiers::NONE), Overlay::None, &config),
+                action
+            );
+        }
+    }
+
+    #[test]
+    fn release_and_repeat_events_are_ignored() {
+        let config = music_config();
+        for kind in [KeyEventKind::Release, KeyEventKind::Repeat] {
+            for code in [
+                KeyCode::F(7), KeyCode::F(8), KeyCode::F(9), KeyCode::Left,
+                KeyCode::Right, KeyCode::Char(' '), KeyCode::Enter, KeyCode::Esc,
+            ] {
+                for overlay in [Overlay::None, Overlay::SettingsModal, Overlay::Playlist] {
+                    assert_eq!(
+                        map_key(KeyEvent::new_with_kind(code, KeyModifiers::NONE, kind), overlay, &config),
+                        Action::None
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn overlays_consume_music_keys_before_playback() {
+        let config = music_config();
+        for overlay in [
+            Overlay::Playlist, Overlay::SettingsModal, Overlay::BarSettingsModal,
+            Overlay::LocalAudioSettingsModal, Overlay::AboutModal,
+            Overlay::AcoustIdModal, Overlay::HelpModal, Overlay::EqModal,
+        ] {
+            for code in [KeyCode::F(7), KeyCode::F(8), KeyCode::F(9)] {
+                assert_eq!(
+                    map_key(KeyEvent::new(code, KeyModifiers::NONE), overlay, &config),
+                    Action::None
+                );
+            }
+        }
+        assert_eq!(
+            map_key(KeyEvent::new(KeyCode::Char(' '), KeyModifiers::NONE), Overlay::AcoustIdModal, &config),
+            Action::FolderChar(' ')
+        );
+        assert_eq!(
+            map_key(KeyEvent::new(KeyCode::Left, KeyModifiers::NONE), Overlay::SettingsModal, &config),
+            Action::ModalLeft
+        );
+        assert_eq!(
+            map_key(KeyEvent::new(KeyCode::Right, KeyModifiers::NONE), Overlay::EqModal, &config),
+            Action::ModalRight
+        );
+    }
+}
